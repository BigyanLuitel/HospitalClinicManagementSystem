@model AppointmentFormViewModel
@{ViewData["Title"]="Edit Appointment";}
<div class="page-heading"><div><h1>Edit appointment #@Model.AppointmentID</h1><p>Reschedule or update appointment status.</p></div><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.AppointmentID">Back</a></div>
<div class="panel form-card"><div class="panel-body"><form method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="AppointmentID"/><partial name="_Form" model="Model"/><div class="mt-4"><button class="btn btn-primary">Save changes</button></div></form></div></div>
