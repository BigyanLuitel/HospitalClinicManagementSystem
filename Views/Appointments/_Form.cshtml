@model AppointmentFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="PatientID" class="form-label"></label><select asp-for="PatientID" asp-items="Model.Patients" class="form-select"><option value="0">Select patient</option></select><span asp-validation-for="PatientID" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="DoctorID" class="form-label"></label><select asp-for="DoctorID" asp-items="Model.Doctors" class="form-select"><option value="0">Select doctor</option></select><span asp-validation-for="DoctorID" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="AppointmentDate" class="form-label"></label><input asp-for="AppointmentDate" type="date" class="form-control" /><span asp-validation-for="AppointmentDate" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="AppointmentTime" class="form-label"></label><input asp-for="AppointmentTime" type="time" class="form-control" /><span asp-validation-for="AppointmentTime" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Scheduled</option><option>Completed</option><option>Cancelled</option></select></div>
    <div class="col-12"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" class="form-control" rows="3" placeholder="Reason for visit"></textarea><span asp-validation-for="Reason" class="text-danger small"></span></div>
</div>
