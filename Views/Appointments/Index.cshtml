@model PagedResult<AppointmentListItem>
@{
    ViewData["Title"]="Appointments";
    string Current(string col)=>string.Equals((string?)ViewBag.SortBy,col,StringComparison.OrdinalIgnoreCase)&&string.Equals((string?)ViewBag.SortOrder,"asc",StringComparison.OrdinalIgnoreCase)?"desc":"asc";
}
<div class="page-heading"><div><h1>Appointments</h1><p>Consolidated appointment data with patient and doctor details in one view.</p></div><a class="btn btn-primary" asp-action="Create">Book appointment</a></div>
<form class="filter-bar row g-2 align-items-end" method="get">
    <div class="col-lg-3 col-md-6"><label class="form-label">Search</label><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Patient, doctor or reason" /></div>
    <div class="col-lg-2 col-md-6"><label class="form-label">Doctor</label><select class="form-select" name="doctorId"><option value="">All doctors</option>@foreach(var d in (IEnumerable<Doctor>)ViewBag.Doctors){<option value="@d.DoctorID" selected="@(ViewBag.DoctorId!=null && d.DoctorID==(int)ViewBag.DoctorId)">@d.FullName</option>}</select></div>
    <div class="col-lg-2 col-md-4"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All</option><option selected="@((string?)ViewBag.Status=="Scheduled")">Scheduled</option><option selected="@((string?)ViewBag.Status=="Completed")">Completed</option><option selected="@((string?)ViewBag.Status=="Cancelled")">Cancelled</option></select></div>
    <div class="col-lg-2 col-md-4"><label class="form-label">From date</label><input class="form-control" type="date" name="fromDate" value="@ViewBag.FromDate" /></div>
    <div class="col-lg-2 col-md-4"><label class="form-label">To date</label><input class="form-control" type="date" name="toDate" value="@ViewBag.ToDate" /></div>
    <div class="col-lg-1 col-md-12 d-flex gap-1"><button class="btn btn-primary flex-fill">Go</button><a class="btn btn-outline-secondary" asp-action="Index">×</a></div>
</form>
<div class="table-wrap"><table class="table"><thead><tr>
<th><a class="sort-link" asp-route-search="@ViewBag.Search" asp-route-doctorId="@ViewBag.DoctorId" asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-sortBy="date" asp-route-sortOrder="@Current("date")">Date ↕</a></th>
<th><a class="sort-link" asp-route-sortBy="time" asp-route-sortOrder="@Current("time")" asp-route-search="@ViewBag.Search" asp-route-doctorId="@ViewBag.DoctorId" asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">Time ↕</a></th>
<th><a class="sort-link" asp-route-sortBy="patient" asp-route-sortOrder="@Current("patient")" asp-route-search="@ViewBag.Search" asp-route-doctorId="@ViewBag.DoctorId" asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">Patient ↕</a></th>
<th><a class="sort-link" asp-route-sortBy="doctor" asp-route-sortOrder="@Current("doctor")" asp-route-search="@ViewBag.Search" asp-route-doctorId="@ViewBag.DoctorId" asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">Doctor ↕</a></th><th>Reason</th>
<th><a class="sort-link" asp-route-sortBy="status" asp-route-sortOrder="@Current("status")" asp-route-search="@ViewBag.Search" asp-route-doctorId="@ViewBag.DoctorId" asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">Status ↕</a></th><th></th></tr></thead><tbody>
@if(Model.Items.Count==0){<tr><td colspan="7" class="empty-state">No appointments match the selected filters.</td></tr>}else{@foreach(var a in Model.Items){var cls="status-"+a.Status.ToLowerInvariant();<tr><td>@a.AppointmentDate.ToString("dd MMM yyyy")</td><td>@DateTime.Today.Add(a.AppointmentTime).ToString("hh:mm tt")</td><td><strong>@a.PatientName</strong><div class="small text-secondary">#@a.PatientID</div></td><td><strong>@a.DoctorName</strong><div class="small text-secondary">@a.Specialization</div></td><td>@(a.Reason??"—")</td><td><span class="badge-status @cls">@a.Status</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@a.AppointmentID">View</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@a.AppointmentID">Edit</a></td></tr>}}
</tbody></table></div>
<div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2"><div class="text-secondary small">Showing @Model.Items.Count of @Model.TotalItems appointment(s)</div>@if(Model.TotalPages>1){<nav><ul class="pagination pagination-sm mb-0"><li class="page-item @(!Model.HasPreviousPage?"disabled":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-doctorId="@ViewBag.DoctorId" asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page-1)" asp-route-pageSize="@Model.PageSize">Previous</a></li>@for(int i=Math.Max(1,Model.Page-2);i<=Math.Min(Model.TotalPages,Model.Page+2);i++){<li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-doctorId="@ViewBag.DoctorId" asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a></li>}<li class="page-item @(!Model.HasNextPage?"disabled":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-doctorId="@ViewBag.DoctorId" asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page+1)" asp-route-pageSize="@Model.PageSize">Next</a></li></ul></nav>}</div>
