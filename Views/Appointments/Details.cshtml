@model AppointmentListItem
@{ViewData["Title"]="Appointment Details";var cls="status-"+Model.Status.ToLowerInvariant();}
<div class="page-heading"><div><h1>Appointment #@Model.AppointmentID</h1><p>@Model.AppointmentDate.ToString("dddd, dd MMMM yyyy") · @DateTime.Today.Add(Model.AppointmentTime).ToString("hh:mm tt")</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.AppointmentID">Edit</a>@if(Model.Status=="Scheduled"){<form method="post" asp-action="Cancel" asp-route-id="@Model.AppointmentID">@Html.AntiForgeryToken()<button class="btn btn-outline-danger" onclick="return confirm('Cancel this appointment?');">Cancel</button></form>}</div></div>
<div class="row g-3"><div class="col-lg-7"><div class="panel"><div class="panel-header d-flex justify-content-between"><strong>Appointment information</strong><span class="badge-status @cls">@Model.Status</span></div><div class="panel-body"><dl class="row details-grid"><dt class="col-sm-4">Patient</dt><dd class="col-sm-8"><a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientID">@Model.PatientName</a></dd><dt class="col-sm-4">Doctor</dt><dd class="col-sm-8">@Model.DoctorName <span class="text-secondary">(@Model.Specialization)</span></dd><dt class="col-sm-4">Reason</dt><dd class="col-sm-8">@(Model.Reason??"—")</dd><dt class="col-sm-4">Consultation fee</dt><dd class="col-sm-8">Rs @Model.ConsultationFee.ToString("N2")</dd><dt class="col-sm-4">Created</dt><dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</dd></dl></div></div></div>
<div class="col-lg-5"><div class="panel"><div class="panel-header"><strong>Clinical actions</strong></div><div class="panel-body d-grid gap-2"><a class="btn btn-outline-primary" asp-controller="MedicalHistory" asp-action="Create" asp-route-appointmentId="@Model.AppointmentID">Record diagnosis / notes</a><a class="btn btn-outline-primary" asp-controller="Prescriptions" asp-action="Create" asp-route-appointmentId="@Model.AppointmentID">Issue prescription</a>@if(Model.Status=="Completed"){<a class="btn btn-teal" asp-controller="Billing" asp-action="Create" asp-route-appointmentId="@Model.AppointmentID">Generate bill</a>}else{<div class="small text-secondary">Mark the appointment Completed before generating a bill.</div>}</div></div></div></div>
