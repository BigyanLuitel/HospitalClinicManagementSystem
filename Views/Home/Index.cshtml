@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="page-heading">
    <div><h1>Hospital Dashboard</h1><p>Quick overview of patients, doctors, appointments and billing.</p></div>
    <div class="d-flex gap-2"><a class="btn btn-primary" asp-controller="Appointments" asp-action="Create">New appointment</a><a class="btn btn-outline-primary" asp-controller="Patients" asp-action="Create">Register patient</a></div>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg"><div class="stat-card"><div class="stat-label">Patients</div><div class="stat-value">@Model.PatientCount</div></div></div>
    <div class="col-6 col-lg"><div class="stat-card"><div class="stat-label">Active doctors</div><div class="stat-value">@Model.ActiveDoctorCount</div></div></div>
    <div class="col-6 col-lg"><div class="stat-card"><div class="stat-label">Today's appointments</div><div class="stat-value">@Model.TodayAppointmentCount</div></div></div>
    <div class="col-6 col-lg"><div class="stat-card"><div class="stat-label">Unpaid bills</div><div class="stat-value">@Model.UnpaidBillCount</div></div></div>
    <div class="col-12 col-lg"><div class="stat-card"><div class="stat-label">Paid this month</div><div class="stat-value">Rs @Model.ThisMonthRevenue.ToString("N2")</div></div></div>
</div>
<div class="panel">
    <div class="panel-header d-flex justify-content-between align-items-center"><div><strong>Upcoming appointments</strong><div class="text-secondary small">Consolidated patient, doctor and schedule data</div></div><a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a></div>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Date</th><th>Time</th><th>Patient</th><th>Doctor</th><th>Reason</th><th></th></tr></thead>
            <tbody>
            @if (Model.UpcomingAppointments.Count == 0)
            { <tr><td colspan="6" class="empty-state">No upcoming scheduled appointments.</td></tr> }
            else
            {
                @foreach (var a in Model.UpcomingAppointments)
                { <tr><td>@a.AppointmentDate.ToString("dd MMM yyyy")</td><td>@DateTime.Today.Add(a.AppointmentTime).ToString("hh:mm tt")</td><td>@a.PatientName</td><td><strong>@a.DoctorName</strong><div class="small text-secondary">@a.Specialization</div></td><td>@(a.Reason ?? "—")</td><td><a class="btn btn-sm btn-outline-secondary" asp-controller="Appointments" asp-action="Details" asp-route-id="@a.AppointmentID">Open</a></td></tr> }
            }
            </tbody>
        </table>
    </div>
</div>
