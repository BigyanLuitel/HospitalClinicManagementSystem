@model MedicalHistoryFormViewModel
@{ViewData["Title"]="Add Medical History";}
<div class="page-heading"><div><h1>Record diagnosis / notes</h1><p>Add a clinical history entry linked to a patient visit.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<div class="panel form-card"><div class="panel-body"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
<div class="col-md-6"><label asp-for="PatientID" class="form-label"></label><select asp-for="PatientID" asp-items="Model.Patients" class="form-select"><option value="0">Select patient</option></select><span asp-validation-for="PatientID" class="text-danger small"></span></div>
<div class="col-md-6"><label asp-for="DoctorID" class="form-label"></label><select asp-for="DoctorID" asp-items="Model.Doctors" class="form-select"><option value="0">Select doctor</option></select><span asp-validation-for="DoctorID" class="text-danger small"></span></div>
<div class="col-md-8"><label asp-for="AppointmentID" class="form-label"></label><select asp-for="AppointmentID" asp-items="Model.Appointments" class="form-select"><option value="">No linked appointment</option></select><span asp-validation-for="AppointmentID" class="text-danger small"></span></div>
<div class="col-md-4"><label asp-for="VisitDate" class="form-label"></label><input asp-for="VisitDate" type="date" class="form-control" /></div>
<div class="col-12"><label asp-for="Diagnosis" class="form-label"></label><textarea asp-for="Diagnosis" rows="3" class="form-control" placeholder="Clinical diagnosis / findings"></textarea></div>
<div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" rows="4" class="form-control" placeholder="Additional observations"></textarea></div>
</div><div class="mt-4"><button class="btn btn-primary">Save history entry</button></div></form></div></div>
