@model PagedResult<MedicalHistoryListItem>
@{ViewData["Title"]="Medical History"; string Current(string col)=>string.Equals((string?)ViewBag.SortBy,col,StringComparison.OrdinalIgnoreCase)&&string.Equals((string?)ViewBag.SortOrder,"asc",StringComparison.OrdinalIgnoreCase)?"desc":"asc";}
<div class="page-heading"><div><h1>Medical history</h1><p>Chronological diagnoses and notes linked to patient visits.</p></div><a class="btn btn-primary" asp-action="Create">Add history entry</a></div>
<form class="filter-bar row g-2 align-items-end" method="get"><div class="col-md-8"><label class="form-label">Search</label><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Patient, diagnosis or notes" /></div><input type="hidden" name="patientId" value="@ViewBag.PatientId"/><div class="col-md-2"><label class="form-label">Rows</label><select name="pageSize" class="form-select"><option selected="@(ViewBag.PageSize==10)">10</option><option selected="@(ViewBag.PageSize==20)">20</option><option selected="@(ViewBag.PageSize==50)">50</option></select></div><div class="col-md-2 d-flex gap-2"><button class="btn btn-primary flex-fill">Apply</button><a class="btn btn-outline-secondary" asp-action="Index">Reset</a></div></form>
<div class="table-wrap"><table class="table"><thead><tr><th><a class="sort-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="date" asp-route-sortOrder="@Current("date")">Visit date ↕</a></th><th><a class="sort-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="patient" asp-route-sortOrder="@Current("patient")">Patient ↕</a></th><th><a class="sort-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="doctor" asp-route-sortOrder="@Current("doctor")">Doctor ↕</a></th><th><a class="sort-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="diagnosis" asp-route-sortOrder="@Current("diagnosis")">Diagnosis ↕</a></th><th>Notes</th><th>Appointment</th></tr></thead><tbody>
@if(Model.Items.Count==0){<tr><td colspan="6" class="empty-state">No medical history records found.</td></tr>}else{@foreach(var h in Model.Items){<tr><td>@h.VisitDate.ToString("dd MMM yyyy")</td><td><a asp-controller="Patients" asp-action="Details" asp-route-id="@h.PatientID">@h.PatientName</a></td><td>@h.DoctorName</td><td>@(h.Diagnosis??"—")</td><td style="max-width:320px">@(h.Notes??"—")</td><td>@if(h.AppointmentID.HasValue){<a asp-controller="Appointments" asp-action="Details" asp-route-id="@h.AppointmentID">#@h.AppointmentID</a>}else{<span>—</span>}</td></tr>}}
</tbody></table></div>
@if(Model.TotalPages>1){<nav class="mt-3"><ul class="pagination pagination-sm"><li class="page-item @(!Model.HasPreviousPage?"disabled":"")"><a class="page-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page-1)" asp-route-pageSize="@Model.PageSize">Previous</a></li>@for(int i=Math.Max(1,Model.Page-2);i<=Math.Min(Model.TotalPages,Model.Page+2);i++){<li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a></li>}<li class="page-item @(!Model.HasNextPage?"disabled":"")"><a class="page-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page+1)" asp-route-pageSize="@Model.PageSize">Next</a></li></ul></nav>}
