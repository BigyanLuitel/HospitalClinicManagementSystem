@model PagedResult<PrescriptionListItem>
@{ViewData["Title"]="Prescriptions"; string Current(string col)=>string.Equals((string?)ViewBag.SortBy,col,StringComparison.OrdinalIgnoreCase)&&string.Equals((string?)ViewBag.SortOrder,"asc",StringComparison.OrdinalIgnoreCase)?"desc":"asc";}
<div class="page-heading"><div><h1>Prescriptions</h1><p>Prescription records linked to appointments and patients.</p></div><a class="btn btn-primary" asp-action="Create">Issue prescription</a></div>
<form class="filter-bar row g-2 align-items-end" method="get"><div class="col-md-7"><label class="form-label">Search</label><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Patient, doctor or medicine" /></div><input type="hidden" name="patientId" value="@ViewBag.PatientId"/><div class="col-md-2"><label class="form-label">Order</label><select class="form-select" name="sortOrder"><option value="desc" selected="@((string?)ViewBag.SortOrder=="desc")">Newest</option><option value="asc" selected="@((string?)ViewBag.SortOrder=="asc")">Oldest</option></select></div><div class="col-md-3 d-flex gap-2"><button class="btn btn-primary flex-fill">Apply</button><a class="btn btn-outline-secondary" asp-action="Index">Reset</a></div></form>
<div class="table-wrap"><table class="table"><thead><tr><th><a class="sort-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="date" asp-route-sortOrder="@Current("date")">Date issued ↕</a></th><th><a class="sort-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="patient" asp-route-sortOrder="@Current("patient")">Patient ↕</a></th><th><a class="sort-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="doctor" asp-route-sortOrder="@Current("doctor")">Doctor ↕</a></th><th><a class="sort-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="medicine" asp-route-sortOrder="@Current("medicine")">Medicines ↕</a></th><th>Dosage</th><th></th></tr></thead><tbody>
@if(Model.Items.Count==0){<tr><td colspan="6" class="empty-state">No prescriptions found.</td></tr>}else{@foreach(var p in Model.Items){<tr><td>@p.DateIssued.ToString("dd MMM yyyy")</td><td>@p.PatientName</td><td>@p.DoctorName</td><td style="max-width:340px">@p.Medicines</td><td>@(p.Dosage??"—")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@p.PrescriptionID">View</a></td></tr>}}
</tbody></table></div>
@if(Model.TotalPages>1){<nav class="mt-3"><ul class="pagination pagination-sm"><li class="page-item @(!Model.HasPreviousPage?"disabled":"")"><a class="page-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page-1)" asp-route-pageSize="@Model.PageSize">Previous</a></li>@for(int i=Math.Max(1,Model.Page-2);i<=Math.Min(Model.TotalPages,Model.Page+2);i++){<li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a></li>}<li class="page-item @(!Model.HasNextPage?"disabled":"")"><a class="page-link" asp-route-patientId="@ViewBag.PatientId" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page+1)" asp-route-pageSize="@Model.PageSize">Next</a></li></ul></nav>}
