@model PrescriptionListItem
@{ViewData["Title"]="Prescription Details";}
<div class="page-heading"><div><h1>Prescription #@Model.PrescriptionID</h1><p>Issued @Model.DateIssued.ToString("dd MMM yyyy, hh:mm tt")</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<div class="panel form-card"><div class="panel-body"><dl class="row details-grid"><dt class="col-sm-4">Patient</dt><dd class="col-sm-8"><a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientID">@Model.PatientName</a></dd><dt class="col-sm-4">Doctor</dt><dd class="col-sm-8">@Model.DoctorName</dd><dt class="col-sm-4">Appointment</dt><dd class="col-sm-8"><a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentID">#@Model.AppointmentID</a></dd><dt class="col-sm-4">Medicines</dt><dd class="col-sm-8" style="white-space:pre-wrap">@Model.Medicines</dd><dt class="col-sm-4">Dosage</dt><dd class="col-sm-8" style="white-space:pre-wrap">@(Model.Dosage??"—")</dd></dl><button class="btn btn-outline-primary" onclick="window.print()">Print prescription</button></div></div>
