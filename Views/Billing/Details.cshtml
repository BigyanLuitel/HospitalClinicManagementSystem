@model BillListItem
@{ViewData["Title"]="Bill Details";var cls=Model.PaymentStatus=="Paid"?"status-paid":Model.PaymentStatus=="Unpaid"?"status-unpaid":"status-partially-paid";}
<div class="page-heading"><div><h1>Bill #@Model.BillID</h1><p>Generated @Model.BillDate.ToString("dd MMM yyyy, hh:mm tt")</p></div><button class="btn btn-outline-primary" onclick="window.print()">Print bill</button></div>
<div class="row g-3"><div class="col-lg-7"><div class="panel"><div class="panel-header d-flex justify-content-between"><strong>Billing details</strong><span class="badge-status @cls">@Model.PaymentStatus</span></div><div class="panel-body"><dl class="row details-grid"><dt class="col-sm-4">Patient</dt><dd class="col-sm-8"><a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientID">@Model.PatientName</a></dd><dt class="col-sm-4">Appointment</dt><dd class="col-sm-8"><a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentID">#@Model.AppointmentID</a> · @Model.AppointmentDate.ToString("dd MMM yyyy")</dd><dt class="col-sm-4">Amount</dt><dd class="col-sm-8 fs-5">Rs @Model.Amount.ToString("N2")</dd><dt class="col-sm-4">Payment method</dt><dd class="col-sm-8">@(Model.PaymentMethod??"—")</dd></dl></div></div></div>
<div class="col-lg-5"><div class="panel"><div class="panel-header"><strong>Update payment</strong></div><div class="panel-body"><form method="post" asp-action="UpdatePayment" asp-route-id="@Model.BillID">@Html.AntiForgeryToken()<div class="mb-3"><label class="form-label">Payment status</label><select name="paymentStatus" class="form-select"><option selected="@(Model.PaymentStatus=="Unpaid")">Unpaid</option><option selected="@(Model.PaymentStatus=="Partially Paid")">Partially Paid</option><option selected="@(Model.PaymentStatus=="Paid")">Paid</option></select></div><div class="mb-3"><label class="form-label">Payment method</label><select name="paymentMethod" class="form-select"><option value="">Not specified</option><option selected="@(Model.PaymentMethod=="Cash")">Cash</option><option selected="@(Model.PaymentMethod=="Card")">Card</option><option selected="@(Model.PaymentMethod=="Insurance")">Insurance</option></select></div><button class="btn btn-primary w-100">Save payment status</button></form></div></div></div></div>
