@model PagedResult<BillListItem>
@{
    ViewData["Title"]="Billing";
    string Current(string col)=>string.Equals((string?)ViewBag.SortBy,col,StringComparison.OrdinalIgnoreCase)&&string.Equals((string?)ViewBag.SortOrder,"asc",StringComparison.OrdinalIgnoreCase)?"desc":"asc";
}
<div class="page-heading"><div><h1>Billing</h1><p>Track consultation bills and payment status.</p></div><a class="btn btn-primary" asp-action="Create">Generate bill</a></div>
<form class="filter-bar row g-2 align-items-end" method="get">
    <div class="col-lg-3 col-md-6"><label class="form-label">Search</label><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Patient or bill ID" /></div>
    <div class="col-lg-2 col-md-6"><label class="form-label">Payment status</label><select class="form-select" name="paymentStatus"><option value="">All</option><option selected="@((string?)ViewBag.PaymentStatus=="Paid")">Paid</option><option selected="@((string?)ViewBag.PaymentStatus=="Unpaid")">Unpaid</option><option selected="@((string?)ViewBag.PaymentStatus=="Partially Paid")">Partially Paid</option></select></div>
    <div class="col-lg-2 col-md-4"><label class="form-label">From date</label><input class="form-control" type="date" name="fromDate" value="@ViewBag.FromDate" /></div>
    <div class="col-lg-2 col-md-4"><label class="form-label">To date</label><input class="form-control" type="date" name="toDate" value="@ViewBag.ToDate" /></div>
    <div class="col-lg-1 col-md-4"><label class="form-label">Rows</label><select class="form-select" name="pageSize"><option selected="@(ViewBag.PageSize==10)">10</option><option selected="@(ViewBag.PageSize==20)">20</option><option selected="@(ViewBag.PageSize==50)">50</option></select></div>
    <div class="col-lg-2 col-md-12 d-flex gap-2"><button class="btn btn-primary flex-fill">Apply</button><a class="btn btn-outline-secondary" asp-action="Index">Reset</a></div>
</form>
<div class="table-wrap"><table class="table"><thead><tr><th>Bill</th><th><a class="sort-link" asp-route-sortBy="patient" asp-route-sortOrder="@Current("patient")" asp-route-search="@ViewBag.Search" asp-route-paymentStatus="@ViewBag.PaymentStatus" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">Patient ↕</a></th><th>Appointment</th><th><a class="sort-link" asp-route-sortBy="amount" asp-route-sortOrder="@Current("amount")">Amount ↕</a></th><th><a class="sort-link" asp-route-sortBy="status" asp-route-sortOrder="@Current("status")">Status ↕</a></th><th><a class="sort-link" asp-route-sortBy="date" asp-route-sortOrder="@Current("date")">Bill date ↕</a></th><th></th></tr></thead><tbody>
@if(Model.Items.Count==0){<tr><td colspan="7" class="empty-state">No bills found.</td></tr>}else{@foreach(var b in Model.Items){var cls=b.PaymentStatus=="Paid"?"status-paid":b.PaymentStatus=="Unpaid"?"status-unpaid":"status-partially-paid";<tr><td>#@b.BillID</td><td><strong>@b.PatientName</strong></td><td><a asp-controller="Appointments" asp-action="Details" asp-route-id="@b.AppointmentID">#@b.AppointmentID</a><div class="small text-secondary">@b.AppointmentDate.ToString("dd MMM yyyy")</div></td><td>Rs @b.Amount.ToString("N2")</td><td><span class="badge-status @cls">@b.PaymentStatus</span></td><td>@b.BillDate.ToString("dd MMM yyyy")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@b.BillID">View</a></td></tr>}}
</tbody></table></div>
@if(Model.TotalPages>1){<nav class="mt-3"><ul class="pagination pagination-sm"><li class="page-item @(!Model.HasPreviousPage?"disabled":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-paymentStatus="@ViewBag.PaymentStatus" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page-1)" asp-route-pageSize="@Model.PageSize">Previous</a></li>@for(int i=Math.Max(1,Model.Page-2);i<=Math.Min(Model.TotalPages,Model.Page+2);i++){<li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-paymentStatus="@ViewBag.PaymentStatus" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a></li>}<li class="page-item @(!Model.HasNextPage?"disabled":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-paymentStatus="@ViewBag.PaymentStatus" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page+1)" asp-route-pageSize="@Model.PageSize">Next</a></li></ul></nav>}
