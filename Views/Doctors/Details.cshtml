@model Doctor
@{ViewData["Title"]="Doctor Details";}
<div class="page-heading"><div><h1>@Model.FullName</h1><p>@Model.Specialization</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.DoctorID">Edit</a>@if(Model.Status=="Active"){<form method="post" asp-action="Deactivate" asp-route-id="@Model.DoctorID">@Html.AntiForgeryToken()<button class="btn btn-outline-danger" onclick="return confirm('Mark this doctor inactive?');">Deactivate</button></form>}<form method="post" asp-action="Delete" asp-route-id="@Model.DoctorID">@Html.AntiForgeryToken()<button class="btn btn-outline-danger" onclick="return confirm('Delete this doctor? This only succeeds when no related records exist.');">Delete</button></form></div></div>
<div class="panel form-card"><div class="panel-body"><dl class="row details-grid"><dt class="col-sm-4">Status</dt><dd class="col-sm-8"><span class="badge-status @(Model.Status=="Active"?"status-active":"status-inactive")">@Model.Status</span></dd><dt class="col-sm-4">Contact</dt><dd class="col-sm-8">@Model.ContactNumber</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email??"—")</dd><dt class="col-sm-4">Available days</dt><dd class="col-sm-8">@(Model.AvailableDays??"—")</dd><dt class="col-sm-4">Consultation fee</dt><dd class="col-sm-8">Rs @Model.ConsultationFee.ToString("N2")</dd></dl></div></div>
