@model PagedResult<Doctor>
@{
    ViewData["Title"]="Doctors";
    string Current(string col)=>string.Equals((string?)ViewBag.SortBy,col,StringComparison.OrdinalIgnoreCase)&&string.Equals((string?)ViewBag.SortOrder,"asc",StringComparison.OrdinalIgnoreCase)?"desc":"asc";
}
<div class="page-heading"><div><h1>Doctors</h1><p>Maintain doctor profiles, specializations, fees and availability.</p></div><a class="btn btn-primary" asp-action="Create">Add doctor</a></div>
<form class="filter-bar row g-2 align-items-end" method="get">
<div class="col-md-5"><label class="form-label">Search</label><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Doctor name or contact" /></div>
<div class="col-md-3"><label class="form-label">Specialization</label><select class="form-select" name="specialization"><option value="">All</option>@foreach(var s in (IEnumerable<string>)ViewBag.Specializations){<option value="@s" selected="@(s==(string?)ViewBag.Specialization)">@s</option>}</select></div>
<div class="col-md-2"><label class="form-label">Rows</label><select class="form-select" name="pageSize"><option selected="@(ViewBag.PageSize==10)">10</option><option selected="@(ViewBag.PageSize==20)">20</option><option selected="@(ViewBag.PageSize==50)">50</option></select></div>
<div class="col-md-2 d-flex gap-2"><button class="btn btn-primary flex-fill">Apply</button><a class="btn btn-outline-secondary" asp-action="Index">Reset</a></div>
</form>
<div class="table-wrap"><table class="table"><thead><tr><th><a class="sort-link" asp-route-search="@ViewBag.Search" asp-route-specialization="@ViewBag.Specialization" asp-route-sortBy="name" asp-route-sortOrder="@Current("name")">Doctor ↕</a></th><th><a class="sort-link" asp-route-search="@ViewBag.Search" asp-route-specialization="@ViewBag.Specialization" asp-route-sortBy="specialization" asp-route-sortOrder="@Current("specialization")">Specialization ↕</a></th><th>Availability</th><th><a class="sort-link" asp-route-sortBy="fee" asp-route-sortOrder="@Current("fee")">Fee ↕</a></th><th><a class="sort-link" asp-route-sortBy="status" asp-route-sortOrder="@Current("status")">Status ↕</a></th><th></th></tr></thead><tbody>
@if(Model.Items.Count==0){<tr><td colspan="6" class="empty-state">No doctors found.</td></tr>}else{@foreach(var d in Model.Items){<tr><td><strong>@d.FullName</strong><div class="small text-secondary">@d.ContactNumber</div></td><td>@d.Specialization</td><td>@(d.AvailableDays??"—")</td><td>Rs @d.ConsultationFee.ToString("N2")</td><td><span class="badge-status @(d.Status=="Active"?"status-active":"status-inactive")">@d.Status</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@d.DoctorID">View</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@d.DoctorID">Edit</a></td></tr>}}
</tbody></table></div>
@if(Model.TotalPages>1){<nav class="mt-3"><ul class="pagination pagination-sm"><li class="page-item @(!Model.HasPreviousPage?"disabled":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-specialization="@ViewBag.Specialization" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page-1)" asp-route-pageSize="@Model.PageSize">Previous</a></li>@for(int i=Math.Max(1,Model.Page-2);i<=Math.Min(Model.TotalPages,Model.Page+2);i++){<li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-specialization="@ViewBag.Specialization" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a></li>}<li class="page-item @(!Model.HasNextPage?"disabled":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-specialization="@ViewBag.Specialization" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page+1)" asp-route-pageSize="@Model.PageSize">Next</a></li></ul></nav>}
