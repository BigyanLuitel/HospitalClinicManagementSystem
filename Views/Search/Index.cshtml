@model List<PatientSearchResult>
@{ViewData["Title"]="Patient Search";}
<div class="page-heading"><div><h1>Patient search</h1><p>Search by patient ID, name or contact number.</p></div></div>
<form class="filter-bar row g-2" method="get"><div class="col-md-10"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Enter patient ID, name or phone number" autofocus /></div><div class="col-md-2"><button class="btn btn-primary w-100">Search</button></div></form>
@if(string.IsNullOrWhiteSpace((string?)ViewBag.Query)){<div class="panel"><div class="empty-state">Enter a patient ID, name or contact number to search.</div></div>}else{<div class="table-wrap"><table class="table"><thead><tr><th>ID</th><th>Patient</th><th>Date of birth</th><th>Contact</th><th>Blood</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="empty-state">No matching patients.</td></tr>}else{@foreach(var p in Model){<tr><td>#@p.PatientID</td><td><strong>@p.FullName</strong><div class="small text-secondary">@p.Email</div></td><td>@p.DateOfBirth.ToString("dd MMM yyyy")</td><td>@p.ContactNumber</td><td>@(p.BloodGroup??"—")</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Patients" asp-action="Details" asp-route-id="@p.PatientID">Open profile</a></td></tr>}}</tbody></table></div>}
