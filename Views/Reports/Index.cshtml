@model ReportViewModel
@{ViewData["Title"]="Reports";}
<div class="page-heading"><div><h1>Reports</h1><p>Date-based appointment and billing summary.</p></div></div>
<form class="filter-bar row g-2 align-items-end" method="get"><div class="col-md-5"><label class="form-label">From date</label><input type="date" class="form-control" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" /></div><div class="col-md-5"><label class="form-label">To date</label><input type="date" class="form-control" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" /></div><div class="col-md-2"><button class="btn btn-primary w-100">Run report</button></div></form>
<div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-label">Appointments</div><div class="stat-value">@Model.TotalAppointments</div></div></div><div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-label">Completed</div><div class="stat-value">@Model.CompletedAppointments</div></div></div><div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-label">Total billed</div><div class="stat-value">Rs @Model.TotalBilled.ToString("N2")</div></div></div><div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-label">Outstanding</div><div class="stat-value">Rs @Model.TotalOutstanding.ToString("N2")</div></div></div></div>
<div class="row g-3"><div class="col-lg-5"><div class="panel h-100"><div class="panel-header"><strong>Appointment status</strong></div><div class="panel-body"><div class="d-flex justify-content-between py-2 border-bottom"><span>Scheduled</span><strong>@Model.ScheduledAppointments</strong></div><div class="d-flex justify-content-between py-2 border-bottom"><span>Completed</span><strong>@Model.CompletedAppointments</strong></div><div class="d-flex justify-content-between py-2"><span>Cancelled</span><strong>@Model.CancelledAppointments</strong></div><hr/><div class="d-flex justify-content-between py-2"><span>Paid amount</span><strong>Rs @Model.TotalPaid.ToString("N2")</strong></div><div class="d-flex justify-content-between py-2"><span>Outstanding amount</span><strong>Rs @Model.TotalOutstanding.ToString("N2")</strong></div></div></div></div><div class="col-lg-7"><div class="panel"><div class="panel-header"><strong>Appointments by day</strong></div><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th class="text-end">Appointments</th></tr></thead><tbody>@if(Model.DailyAppointments.Count==0){<tr><td colspan="2" class="empty-state">No appointment data in this range.</td></tr>}else{@foreach(var d in Model.DailyAppointments){<tr><td>@d.Date.ToString("dd MMM yyyy")</td><td class="text-end"><strong>@d.Count</strong></td></tr>}}</tbody></table></div></div></div></div>
