@model Patient
@{ViewData["Title"]="Edit Patient";}
<div class="page-heading"><div><h1>Edit patient</h1><p>Update demographic and contact information.</p></div><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.PatientID">Back</a></div>
<div class="panel form-card"><div class="panel-body"><form method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="PatientID" /><partial name="_Form" model="Model" /><div class="mt-4"><button class="btn btn-primary">Save changes</button></div></form></div></div>
