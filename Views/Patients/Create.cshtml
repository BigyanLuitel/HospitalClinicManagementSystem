@model Patient
@{ViewData["Title"]="Register Patient";}
<div class="page-heading"><div><h1>Register patient</h1><p>Create a new patient record.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<div class="panel form-card"><div class="panel-body"><form method="post">@Html.AntiForgeryToken()<partial name="_Form" model="Model" /><div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save patient</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form></div></div>
