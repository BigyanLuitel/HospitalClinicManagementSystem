@model PagedResult<Patient>
@{
    ViewData["Title"]="Patients";
    string Current(string col)=>string.Equals((string?)ViewBag.SortBy,col,StringComparison.OrdinalIgnoreCase)&&string.Equals((string?)ViewBag.SortOrder,"asc",StringComparison.OrdinalIgnoreCase)?"desc":"asc";
}
<div class="page-heading"><div><h1>Patients</h1><p>Register, search and manage patient records.</p></div><a class="btn btn-primary" asp-action="Create">Register patient</a></div>
<form class="filter-bar row g-2 align-items-end" method="get">
    <div class="col-md-7"><label class="form-label">Search</label><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Name, patient ID or contact number" /></div>
    <div class="col-md-2"><label class="form-label">Rows</label><select name="pageSize" class="form-select"><option selected="@(ViewBag.PageSize==10)">10</option><option selected="@(ViewBag.PageSize==20)">20</option><option selected="@(ViewBag.PageSize==50)">50</option></select></div>
    <div class="col-md-3 d-flex gap-2"><button class="btn btn-primary flex-fill">Apply</button><a class="btn btn-outline-secondary" asp-action="Index">Reset</a></div>
</form>
<div class="table-wrap">
<table class="table"><thead><tr>
    <th><a class="sort-link" asp-route-search="@ViewBag.Search" asp-route-sortBy="id" asp-route-sortOrder="@Current("id")" asp-route-pageSize="@ViewBag.PageSize">ID ↕</a></th>
    <th><a class="sort-link" asp-route-search="@ViewBag.Search" asp-route-sortBy="name" asp-route-sortOrder="@Current("name")" asp-route-pageSize="@ViewBag.PageSize">Patient ↕</a></th>
    <th><a class="sort-link" asp-route-search="@ViewBag.Search" asp-route-sortBy="dob" asp-route-sortOrder="@Current("dob")" asp-route-pageSize="@ViewBag.PageSize">DOB ↕</a></th>
    <th>Gender</th><th><a class="sort-link" asp-route-search="@ViewBag.Search" asp-route-sortBy="contact" asp-route-sortOrder="@Current("contact")" asp-route-pageSize="@ViewBag.PageSize">Contact ↕</a></th><th>Blood</th><th></th>
</tr></thead><tbody>
@if(Model.Items.Count==0){<tr><td colspan="7" class="empty-state">No patients found.</td></tr>}else{@foreach(var p in Model.Items){<tr><td>#@p.PatientID</td><td><strong>@p.FullName</strong><div class="small text-secondary">@p.Email</div></td><td>@p.DateOfBirth.ToString("dd MMM yyyy")</td><td>@p.Gender</td><td>@p.ContactNumber</td><td>@(p.BloodGroup??"—")</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@p.PatientID">View</a> <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.PatientID">Edit</a></td></tr>}}
</tbody></table></div>
@if(Model.TotalPages>1){<nav class="mt-3"><ul class="pagination pagination-sm"><li class="page-item @(!Model.HasPreviousPage?"disabled":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page-1)" asp-route-pageSize="@Model.PageSize">Previous</a></li>@for(var i=Math.Max(1,Model.Page-2);i<=Math.Min(Model.TotalPages,Model.Page+2);i++){<li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a></li>}<li class="page-item @(!Model.HasNextPage?"disabled":"")"><a class="page-link" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-sortOrder="@ViewBag.SortOrder" asp-route-page="@(Model.Page+1)" asp-route-pageSize="@Model.PageSize">Next</a></li></ul></nav>}
