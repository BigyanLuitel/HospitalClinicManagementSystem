@model Patient
@{ViewData["Title"]="Patient Details";}
<div class="page-heading"><div><h1>@Model.FullName</h1><p>Patient #@Model.PatientID · Registered @Model.RegistrationDate.ToString("dd MMM yyyy")</p></div><div class="d-flex gap-2"><a class="btn btn-primary" asp-controller="Appointments" asp-action="Create" asp-route-patientId="@Model.PatientID">Book appointment</a><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.PatientID">Edit</a></div></div>
<div class="row g-3">
<div class="col-lg-7"><div class="panel"><div class="panel-header"><strong>Patient information</strong></div><div class="panel-body"><dl class="row details-grid"><dt class="col-sm-4">Date of birth</dt><dd class="col-sm-8">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd><dt class="col-sm-4">Gender</dt><dd class="col-sm-8">@Model.Gender</dd><dt class="col-sm-4">Blood group</dt><dd class="col-sm-8">@(Model.BloodGroup??"Not specified")</dd><dt class="col-sm-4">Contact</dt><dd class="col-sm-8">@Model.ContactNumber</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email??"—")</dd><dt class="col-sm-4">Address</dt><dd class="col-sm-8">@(Model.Address??"—")</dd></dl></div></div></div>
<div class="col-lg-5"><div class="panel"><div class="panel-header"><strong>Related records</strong></div><div class="panel-body d-grid gap-2"><a class="btn btn-outline-primary" asp-controller="Appointments" asp-action="Index" asp-route-search="@Model.FullName">Appointments</a><a class="btn btn-outline-primary" asp-controller="MedicalHistory" asp-action="Index" asp-route-patientId="@Model.PatientID">Medical history</a><a class="btn btn-outline-primary" asp-controller="Prescriptions" asp-action="Index" asp-route-patientId="@Model.PatientID">Prescriptions</a><form asp-action="Delete" asp-route-id="@Model.PatientID" method="post" onsubmit="return confirm('Delete this patient? This only succeeds when no related records exist.');">@Html.AntiForgeryToken()<button class="btn btn-outline-danger w-100">Delete patient</button></form></div></div></div>
</div>
